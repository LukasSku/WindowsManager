<UserControl x:Class="WindowsManager.App.Views.AppManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                <TextBlock Text="{DynamicResource AppManager_Title}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{DynamicResource AppManager_Subtitle}"
                           FontSize="14" Margin="0,4,0,20"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <!-- Install new software via winget -->
                <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource AppManager_Install_Title}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <Border Style="{StaticResource HelpIconStyle}" ToolTip="{DynamicResource AppManager_Install_Help}">
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource AppManager_Install_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Grid.Column="0" Padding="10,8" FontSize="13"
                                     Background="{DynamicResource WindowBackgroundBrush}"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                     VerticalContentAlignment="Center"
                                     Tag="{DynamicResource AppManager_SearchPlaceholder}"
                                     KeyDown="SearchBox_KeyDown" />
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{DynamicResource AppManager_SearchButton}"
                                    Margin="8,0,0,0" Click="Search_Click" />
                        </Grid>

                        <TextBlock x:Name="SearchLoadingText" Text="{DynamicResource Common_Loading}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed" />
                        <TextBlock x:Name="SearchNotAvailableText" Text="{DynamicResource AppManager_WingetNotAvailable}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed"
                                   TextWrapping="Wrap" />
                        <ItemsControl x:Name="SearchResultsList" />
                    </StackPanel>
                </Expander>

                <!-- Installed applications / uninstall -->
                <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource AppManager_Installed_Title}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <Border Style="{StaticResource HelpIconStyle}" ToolTip="{DynamicResource AppManager_Installed_Help}">
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource AppManager_Installed_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstalledFilterBox" Grid.Column="0" Padding="10,8" FontSize="13"
                                     Background="{DynamicResource WindowBackgroundBrush}"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                     VerticalContentAlignment="Center"
                                     Tag="{DynamicResource AppManager_FilterPlaceholder}"
                                     TextChanged="InstalledFilterBox_TextChanged" />
                            <Button Grid.Column="1" Style="{StaticResource TopBarButtonStyle}"
                                    ToolTip="{DynamicResource Common_Refresh}"
                                    Margin="8,0,0,0" Click="RefreshInstalled_Click">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            </Button>
                        </Grid>

                        <TextBlock x:Name="InstalledLoadingText" Text="{DynamicResource Common_Loading}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed" />
                        <ItemsControl x:Name="InstalledList" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border x:Name="StatusBar" Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0"
                Padding="32,10" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" FontSize="13" />
        </Border>
    </Grid>
</UserControl>
