<UserControl x:Class="WindowsManager.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                <TextBlock Text="{DynamicResource Dashboard_Title}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{DynamicResource Dashboard_Subtitle}"
                           FontSize="14" Margin="0,4,0,20"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <!-- CPU + RAM side by side -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard_Cpu_Title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock x:Name="CpuPercentText" Text="0%" FontSize="26" FontWeight="Bold"
                                       Margin="0,8,0,8" Foreground="{DynamicResource AccentBrush}" />
                            <Border Height="8" CornerRadius="4" Background="{DynamicResource BorderBrush2}">
                                <Border x:Name="CpuBarFill" Height="8" CornerRadius="4" HorizontalAlignment="Left"
                                        Width="0" Background="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard_Ram_Title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock x:Name="RamUsageText" Text="0 / 0 GB" FontSize="26" FontWeight="Bold"
                                       Margin="0,8,0,8" Foreground="{DynamicResource AccentBrush}" />
                            <Border Height="8" CornerRadius="4" Background="{DynamicResource BorderBrush2}">
                                <Border x:Name="RamBarFill" Height="8" CornerRadius="4" HorizontalAlignment="Left"
                                        Width="0" Background="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Storage -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_Disk_Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10" />
                        <ItemsControl x:Name="DriveList" />
                    </StackPanel>
                </Border>

                <!-- System info -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_System_Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                        <TextBlock x:Name="OsNameText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
                        <TextBlock x:Name="OsBuildText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,0" />
                        <TextBlock x:Name="MachineNameText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- System Restore -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Dashboard_RestorePoint_Title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <Border Style="{StaticResource HelpIconStyle}" ToolTip="{DynamicResource Dashboard_RestorePoint_Help}">
                                <TextBlock Text="?" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_RestorePoint_Desc}" FontSize="12" Margin="0,2,0,10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{DynamicResource Dashboard_RestorePoint_CreateButton}"
                                    Click="CreateRestorePoint_Click" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{DynamicResource Dashboard_RestorePoint_OpenButton}"
                                    Margin="8,0,0,0" Click="OpenSystemRestore_Click" />
                        </StackPanel>
                        <TextBlock x:Name="RestorePointStatusText" FontSize="12" Margin="0,10,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
