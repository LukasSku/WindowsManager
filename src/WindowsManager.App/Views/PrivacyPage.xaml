<UserControl x:Class="WindowsManager.App.Views.PrivacyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                <TextBlock Text="{DynamicResource Privacy_Title}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{DynamicResource Privacy_Subtitle}"
                           FontSize="14" Margin="0,4,0,20"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <!-- Telemetry -->
                <Border x:Name="TelemetrySection" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="{DynamicResource Privacy_Telemetry_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Privacy_Telemetry_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource HelpIconStyle}" ToolTip="{DynamicResource Privacy_Telemetry_Help}"
                                VerticalAlignment="Top" Margin="0,2,0,0">
                            <TextBlock Text="?" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                        <CheckBox Grid.Column="2" x:Name="TelemetryToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  Click="TelemetryToggle_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Advertising ID -->
                <Border x:Name="AdvertisingIdSection" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="{DynamicResource Privacy_AdvertisingId_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Privacy_AdvertisingId_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource HelpIconStyle}" ToolTip="{DynamicResource Privacy_AdvertisingId_Help}"
                                VerticalAlignment="Top" Margin="0,2,0,0">
                            <TextBlock Text="?" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                        <CheckBox Grid.Column="2" x:Name="AdvertisingIdToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  Click="AdvertisingIdToggle_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Activity History -->
                <Border x:Name="ActivityHistorySection" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="{DynamicResource Privacy_ActivityHistory_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Privacy_ActivityHistory_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource HelpIconStyle}" ToolTip="{DynamicResource Privacy_ActivityHistory_Help}"
                                VerticalAlignment="Top" Margin="0,2,0,0">
                            <TextBlock Text="?" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                        <CheckBox Grid.Column="2" x:Name="ActivityHistoryToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  Click="ActivityHistoryToggle_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Location Services -->
                <Border x:Name="LocationSection" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="{DynamicResource Privacy_Location_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Privacy_Location_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource HelpIconStyle}" ToolTip="{DynamicResource Privacy_Location_Help}"
                                VerticalAlignment="Top" Margin="0,2,0,0">
                            <TextBlock Text="?" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                        <CheckBox Grid.Column="2" x:Name="LocationToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  Click="LocationToggle_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Tips & Feedback -->
                <Border x:Name="TipsFeedbackSection" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="{DynamicResource Privacy_TipsFeedback_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Privacy_TipsFeedback_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource HelpIconStyle}" ToolTip="{DynamicResource Privacy_TipsFeedback_Help}"
                                VerticalAlignment="Top" Margin="0,2,0,0">
                            <TextBlock Text="?" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                        <CheckBox Grid.Column="2" x:Name="TipsFeedbackToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  Click="TipsFeedbackToggle_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Camera & Microphone -->
                <Border x:Name="CameraMicSection" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="{DynamicResource Privacy_CameraMic_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Privacy_CameraMic_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource HelpIconStyle}" ToolTip="{DynamicResource Privacy_CameraMic_Help}"
                                VerticalAlignment="Top" Margin="0,2,0,0">
                            <TextBlock Text="?" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                        <CheckBox Grid.Column="2" x:Name="CameraMicToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  Click="CameraMicToggle_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Inking & Typing Personalization -->
                <Border x:Name="InkingSection" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="{DynamicResource Privacy_Inking_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Privacy_Inking_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource HelpIconStyle}" ToolTip="{DynamicResource Privacy_Inking_Help}"
                                VerticalAlignment="Top" Margin="0,2,0,0">
                            <TextBlock Text="?" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                        <CheckBox Grid.Column="2" x:Name="InkingToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  Click="InkingToggle_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar for success/error feedback -->
        <Border x:Name="StatusBar" Grid.Row="1" Padding="16,10" Visibility="Collapsed"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush2}">
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
