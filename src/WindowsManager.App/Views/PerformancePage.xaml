<UserControl x:Class="WindowsManager.App.Views.PerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                <TextBlock Text="{DynamicResource Performance_Title}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{DynamicResource Performance_Subtitle}"
                           FontSize="14" Margin="0,4,0,20"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <!-- Power Plan -->
                <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Perf_PowerPlan_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Perf_PowerPlan_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl x:Name="PowerPlanList" />
                </Expander>

                <!-- Startup Programs -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Perf_Startup_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Perf_Startup_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Button Style="{StaticResource TopBarButtonStyle}"
                                ToolTip="{DynamicResource Common_Refresh}"
                                HorizontalAlignment="Right" Margin="0,0,0,8"
                                Click="RefreshStartup_Click">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="StartupLoadingText" Text="{DynamicResource Common_Loading}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed" />
                        <ItemsControl x:Name="StartupList" />
                    </StackPanel>
                </Expander>

                <!-- Visual Effects -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Perf_VisualEffects_Title}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="{DynamicResource Perf_VisualEffects_Desc}" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Perf_VisualEffects_Toggle}"
                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" x:Name="VisualEffectsToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  Click="VisualEffectsToggle_Click" />
                    </Grid>
                </Expander>

                <!-- Windows Services -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Perf_Services_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Perf_Services_Desc}" FontSize="12" Margin="0,2,0,4"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Perf_Services_Warning}" FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Button Style="{StaticResource TopBarButtonStyle}"
                                ToolTip="{DynamicResource Common_Refresh}"
                                HorizontalAlignment="Right" Margin="0,0,0,8"
                                Click="RefreshServices_Click">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="ServicesLoadingText" Text="{DynamicResource Common_Loading}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed" />
                        <ItemsControl x:Name="ServicesList" />
                    </StackPanel>
                </Expander>

                <!-- Disk Cleanup -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Perf_TempCleanup_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Perf_TempCleanup_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander.Header>
                    <Button Content="{DynamicResource Perf_TempCleanup_Button}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="TempCleanup_Click" />
                </Expander>

                <!-- Network Optimization -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Perf_Network_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Perf_Network_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Perf_Network_NagleToggle}"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" x:Name="NagleToggle" Style="{StaticResource ToggleSwitchStyle}"
                                      Click="NagleToggle_Click" />
                        </Grid>
                        <Button Content="{DynamicResource Perf_Network_FlushDnsButton}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="FlushDns_Click" />
                    </StackPanel>
                </Expander>

                <!-- Game Mode & GPU -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Perf_Gaming_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Perf_Gaming_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Perf_Gaming_GameModeToggle}"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" x:Name="GameModeToggle" Style="{StaticResource ToggleSwitchStyle}"
                                      Click="GameModeToggle_Click" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Perf_Gaming_GpuSchedulingToggle}"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" x:Name="GpuSchedulingToggle" Style="{StaticResource ToggleSwitchStyle}"
                                      Click="GpuSchedulingToggle_Click" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Perf_Gaming_RestartNote}" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <!-- Explorer Performance -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Perf_Explorer_Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Perf_Explorer_Desc}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Perf_Explorer_ThumbnailsToggle}"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" x:Name="ThumbnailsToggle" Style="{StaticResource ToggleSwitchStyle}"
                                      Click="ThumbnailsToggle_Click" />
                        </Grid>
                        <Button Content="{DynamicResource Perf_Explorer_RestartButton}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RestartExplorer_Click" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>


        <!-- Status bar for success/error feedback -->
        <Border x:Name="StatusBar" Grid.Row="1" Padding="16,10" Visibility="Collapsed"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush2}">
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
