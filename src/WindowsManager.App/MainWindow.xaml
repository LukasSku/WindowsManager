<Window x:Class="WindowsManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsManager.App"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Height="640" Width="960"
        MinHeight="480" MinWidth="720"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,10,16">
                    <Image Source="pack://application:,,,/Assets/AppLogo.png"
                           Width="24" Height="24" Margin="0,0,8,0" />
                    <TextBlock Text="{DynamicResource AppTitle}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                    <RadioButton x:Name="NavDashboard" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="True" Checked="NavDashboard_Checked">
                        <TextBlock Text="{DynamicResource Nav_Dashboard}" />
                    </RadioButton>
                    <RadioButton x:Name="NavPerformance" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 Checked="NavPerformance_Checked">
                        <TextBlock Text="{DynamicResource Nav_Performance}" />
                    </RadioButton>
                    <RadioButton x:Name="NavPrivacy" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 Checked="NavPrivacy_Checked">
                        <TextBlock Text="{DynamicResource Nav_Privacy}" />
                    </RadioButton>
                    <RadioButton x:Name="NavAppManager" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 Checked="NavAppManager_Checked">
                        <TextBlock Text="{DynamicResource Nav_AppManager}" />
                    </RadioButton>
                </StackPanel>

                <!-- Bottom controls: settings gear opens a popup with theme + language options -->
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="18,0,18,18">
                    <Button x:Name="SettingsButton" Style="{StaticResource TopBarButtonStyle}"
                            ToolTip="{DynamicResource Settings_Tooltip}"
                            Click="SettingsButton_Click">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" />
                    </Button>

                    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,0,0,8">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="14" ShadowDepth="2" />
                            </Border.Effect>
                            <StackPanel Width="200">
                                <TextBlock Text="{DynamicResource Settings_Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings_DarkMode}"
                                               Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="ThemeToggleButton" Style="{StaticResource TopBarButtonStyle}"
                                            ToolTip="{DynamicResource ThemeToggle_Tooltip}"
                                            Click="ThemeToggleButton_Click">
                                        <TextBlock x:Name="ThemeIcon" Text="&#xE708;" FontFamily="Segoe MDL2 Assets" />
                                    </Button>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings_Language}"
                                               Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="LanguageToggleButton" Style="{StaticResource TopBarButtonStyle}"
                                            ToolTip="{DynamicResource LanguageToggle_Tooltip}"
                                            Click="LanguageToggleButton_Click">
                                        <TextBlock x:Name="LanguageLabel" Text="EN" FontWeight="SemiBold" />
                                    </Button>
                                </Grid>

                                <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0"
                                        Margin="0,10,0,10" />

                                <Button x:Name="CheckUpdateButton" Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{DynamicResource Settings_CheckForUpdates}"
                                        HorizontalAlignment="Stretch" FontSize="12" Padding="0,8"
                                        Click="CheckUpdateButton_Click" />
                                <TextBlock x:Name="UpdateStatusText" FontSize="11" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <Grid />
            </DockPanel>
        </Border>

        <!-- Content area -->
        <ContentControl x:Name="ContentArea" Grid.Column="1" />
    </Grid>
</Window>
